# Medusa backend the admin portal authenticates against.
# Leave UNSET locally to run in demo mode (mock data, any credentials accepted).
# Demo mode is impossible in a production build — see src/lib/auth/config.ts.
MEDUSA_BACKEND_URL=http://localhost:9000

# Production example:
# MEDUSA_BACKEND_URL=https://packaging-general-backend.onrender.com

# ── Backend side ────────────────────────────────────────────────────────────
# The Medusa backend must allow this app's origin, or every request fails CORS:
#   ADMIN_CORS=https://admin.packaginggeneral.com,http://localhost:3001
# Set that on the BACKEND (Render env), not here.
